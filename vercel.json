{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "mvp",
  "functions": {
    "api/job-hunting.js": {
      "includeFiles": "private/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/job-hunting", "destination": "/api/job-hunting" },
    { "source": "/job-hunting/", "destination": "/api/job-hunting" },
    { "source": "/job-hunting/data", "destination": "/api/job-hunting?view=data" },
    { "source": "/job-hunting/match", "destination": "/api/job-hunting?view=match" }
  ]
}
